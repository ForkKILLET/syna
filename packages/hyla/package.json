{
  "name": "@syna-demo/hyla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Syna demo package @syna-demo/hyla",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "syna": {
