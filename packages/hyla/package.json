  },
  "dependencies": {
    "@syna/core": "0.4.0",
    "@syna-demo/llm-contract": "1.0.0",
    "@syna-demo/logger": "1.1.0",
    "@syna-demo/postgres": "3.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@syna/tsconfig": "0.4.0"
  }
