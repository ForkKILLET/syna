{
  "name": "@syna-demo/llm-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Syna demo package @syna-demo/llm-contract",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "syna": {
    "id": "demo.llm.connector",
    "metadata": {
      "displayName": "LLM Connector",
      "description": "Common LLM capability used by the Syna demos"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@syna/core": "0.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@syna/tsconfig": "0.5.0"
  }
}
