{
  "name": "@syna-demo/fluida",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Syna demo package @syna-demo/fluida",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
